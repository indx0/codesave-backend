<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-06-13--0002-snippet" author="indx0">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="snippet"/>
            </not>
        </preConditions>
        <createTable tableName="snippet">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(256)">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="description" type="text">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="language" type="VARCHAR(256)">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="code" type="text">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="is_public" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false" unique="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_user_snippet"
                             referencedTableName="users"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
        </createTable>
        <createIndex tableName="snippet" indexName="idx_snippet_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>