<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-08-12--0006-snippet-file" author="indx0">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="snippet_file"/>
            </not>
        </preConditions>
        <createTable tableName="snippet_file">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="snippet_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_snippet_snippetfile"
                             referencedTableName="snippet"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="filename" type="VARCHAR(256)">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="code" type="text">
                <constraints nullable="false" unique="false" />
            </column>
        </createTable>

        <createIndex tableName="snippet_file" indexName="idx_snippet_file_snippet_id">
            <column name="snippet_id"/>
        </createIndex>

        <createIndex tableName="snippet_file" indexName="idx_snippet_file_unique_filename" unique="true">
            <column name="snippet_id"/>
            <column name="filename"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>