# Database
DB_HOST=localhost          # Postgres host
DB_PORT=5432               # Postgres port (docker-compose maps 5430:5432)
DB_NAME=backend            # Postgres database name
DB_USERNAME=app            # Postgres user
DB_PASSWORD=test123        # Postgres password

# JWT
JWT_SECRET=NDAZLn6kds04iKqSUIrNThqxlxbVcfe7NtXNYmYY/5E=       # HMAC-SHA key (base64)
JWT_ISSUER=http://localhost:8080                              # Token issuer claim
JWT_ACCESS_TOKEN_EXPIRATION=3600000                           # Access token TTL (ms, default 1h)
JWT_REFRESH_TOKEN_EXPIRATION=2592000000                       # Refresh token TTL (ms, default 30d)

# CORS
BACKEND_ADDRESS=http://localhost:5173     # Frontend origin allowed by CORS

# Server
LISTEN_ADDRESS=0.0.0.0                    # Bind address (use 127.0.0.1 for local-only)
